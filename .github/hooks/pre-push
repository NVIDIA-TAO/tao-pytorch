#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0

# Pre-push checks: SPDX license headers, then pylint, pydocstyle, flake8.
#
# Enable once per clone:
#     git config core.hooksPath .github/hooks
#
# Skip for a single push (use sparingly — CI runs the same checks):
#     git push --no-verify
#     SKIP_LINT=1 git push
#
# Only Python files added or modified by the commits being pushed are checked,
# so the first run after enabling this is fast.

set -uo pipefail

if [ "${SKIP_LINT:-0}" = "1" ]; then
    echo "pre-push: SKIP_LINT=1 set, skipping static analysis."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

# --- per-repository configuration ------------------------------------------
SOURCE_PATHS=(nvidia_tao_pytorch)
# File suffixes required to carry an SPDX license header, checked anywhere in
# the repository rather than only under SOURCE_PATHS.
LICENSE_SUFFIXES=(".py" ".sh")
PYLINT_ARGS=(--rcfile .pylintrc)
PYDOCSTYLE_ARGS=(--ignore=D4,D107,D200,D203,D205,D210,D212,D213,D301,D400,D401)
FLAKE8_ARGS=(--ignore=E24,W504,E501,C400,C403,C408,C409,C414,C413,C416,C417,C419)
# ---------------------------------------------------------------------------

ZERO="0000000000000000000000000000000000000000"
DEFAULT_REMOTE_BRANCH="origin/main"

# Read the refs being pushed from stdin and print the .py files they touch.
collect_changed_files() {
    local local_ref local_sha remote_ref remote_sha range base
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ "$local_sha" = "$ZERO" ] && continue   # branch deletion, nothing to lint

        if [ "$remote_sha" != "$ZERO" ]; then
            range="$remote_sha..$local_sha"
        else
            # New branch on the remote: compare against the default branch.
            base="$(git merge-base "$local_sha" "$DEFAULT_REMOTE_BRANCH" 2>/dev/null)"
            if [ -z "$base" ]; then
                echo "pre-push: cannot determine a merge base with $DEFAULT_REMOTE_BRANCH; skipping." >&2
                continue
            fi
            range="$base..$local_sha"
        fi

        git diff --name-only --diff-filter=AM "$range"
    done
}

# Keep Python files that still exist and live under a configured source path.
filter_lint_files() {
    local file path
    while read -r file; do
        [ -f "$file" ] || continue
        case "$file" in
            *.py) ;;
            *) continue ;;
        esac
        for path in "${SOURCE_PATHS[@]}"; do
            case "$file" in
                "$path"/*) echo "$file"; break ;;
            esac
        done
    done
}

# Keep files that still exist and carry a suffix requiring a license header.
filter_license_files() {
    local file suffix
    while read -r file; do
        [ -f "$file" ] || continue
        for suffix in "${LICENSE_SUFFIXES[@]}"; do
            case "$file" in
                *"$suffix") echo "$file"; break ;;
            esac
        done
    done
}

CHANGED="$(collect_changed_files | sort -u)"

# A plain read loop is used instead of `mapfile`, which is unavailable in older
# versions of bash.
FILES=()
while IFS= read -r changed_file; do
    [ -n "$changed_file" ] && FILES+=("$changed_file")
done < <(printf '%s\n' "$CHANGED" | filter_lint_files)

LICENSE_FILES=()
while IFS= read -r changed_file; do
    [ -n "$changed_file" ] && LICENSE_FILES+=("$changed_file")
done < <(printf '%s\n' "$CHANGED" | filter_license_files)

if [ "${#FILES[@]}" -eq 0 ] && [ "${#LICENSE_FILES[@]}" -eq 0 ]; then
    exit 0
fi

status=0

if [ "${#LICENSE_FILES[@]}" -gt 0 ]; then
    echo "pre-push: checking license headers on ${#LICENSE_FILES[@]} changed file(s)."
    python3 "$REPO_ROOT/.github/hooks/check_license_header.py" "${LICENSE_FILES[@]}" || status=1
fi

if [ "${#FILES[@]}" -eq 0 ]; then
    if [ "$status" -ne 0 ]; then
        echo >&2
        echo "pre-push: checks failed — push aborted." >&2
        echo "          Fix the issues above, or bypass once with 'SKIP_LINT=1 git push'." >&2
        exit 1
    fi
    exit 0
fi

echo "pre-push: running static analysis on ${#FILES[@]} changed Python file(s)."

missing_tool=0
for tool in pylint pydocstyle flake8; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "pre-push: '$tool' is not installed." >&2
        missing_tool=1
    fi
done
if [ "$missing_tool" -eq 1 ]; then
    echo "pre-push: install the linters with 'pip install pylint pydocstyle flake8'," >&2
    echo "          or bypass this check once with 'SKIP_LINT=1 git push'." >&2
    exit 1
fi

echo "--- pylint"
pylint "${PYLINT_ARGS[@]}" "${FILES[@]}" || status=1

echo "--- pydocstyle"
pydocstyle "${PYDOCSTYLE_ARGS[@]}" "${FILES[@]}" || status=1

echo "--- flake8"
flake8 "${FLAKE8_ARGS[@]}" "${FILES[@]}" || status=1

if [ "$status" -ne 0 ]; then
    echo >&2
    echo "pre-push: checks failed — push aborted." >&2
    echo "          Fix the issues above, or bypass once with 'SKIP_LINT=1 git push'." >&2
    exit 1
fi

echo "pre-push: all checks passed."
exit 0
